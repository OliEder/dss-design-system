{
  "name": "@bbv/dss-design-system",
  "version": "0.6.0",
  "description": "DSS Design System — Komponenten-Library für Basketball-Apps (Digitaler Spielbericht, Scoreboard, Vereinsregister)",
  "type": "module",
  "main": "tokens/tokens.css",
  "exports": {
    ".":                "./tokens/tokens.css",
    "./tokens.css":     "./tokens/tokens.css",
    "./tokens.json":    "./tokens/tokens.json",
    "./tailwind":       "./tokens/tailwind.preset.js",
    "./svelte/Button":      "./svelte/Button.svelte",
    "./svelte/Input":       "./svelte/TextInput.svelte",
    "./svelte/Modal":       "./svelte/Modal.svelte",
    "./svelte/Card":        "./svelte/Card.svelte",
    "./svelte/Tabs":        "./svelte/Tabs.svelte",
    "./svelte/Icon":        "./svelte/Icon.svelte",
    "./svelte/Table":       "./svelte/Table.svelte",
    "./svelte/PlayByPlay":  "./svelte/PlayByPlay.svelte",
    "./svelte/TopBar":      "./svelte/TopBar.svelte",
    "./svelte/BottomNav":   "./svelte/BottomNav.svelte",
    "./svelte/Breadcrumbs": "./svelte/Breadcrumbs.svelte",
    "./svelte/Stepper":     "./svelte/Stepper.svelte",
    "./svelte/MatchCard":   "./svelte/MatchCard.svelte",
    "./svelte/PlayerCard":  "./svelte/PlayerCard.svelte",
    "./svelte/EmptyState":  "./svelte/EmptyState.svelte",
    "./svelte/Skeleton":    "./svelte/Skeleton.svelte"
  },
  "files": [
    "tokens/",
    "svelte/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "storybook":       "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "keywords": [
    "design-system",
    "basketball",
    "dss",
    "spielbericht",
    "dbb",
    "tokens",
    "svelte",
    "tailwind",
    "wcag-aaa"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<your-user>/dss-design-system.git"
  },
  "peerDependencies": {
    "svelte":      "^5.0.0",
    "tailwindcss": "^3.4.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "svelte":      { "optional": true },
    "tailwindcss": { "optional": true }
  },
  "devDependencies": {
    "@storybook/addon-a11y":         "^10.4.0",
    "@storybook/addon-themes":       "^10.4.0",
    "@storybook/svelte-vite":        "^10.4.0",
    "@sveltejs/vite-plugin-svelte":  "^6.0.0",
    "storybook":                     "^10.4.0",
    "svelte":                        "^5.0.0",
    "vite":                          "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "cookie": "^0.7.0",
    "esbuild": "^0.25.0",
    "vite": "^7.0.0"
  }
